# Public site URL (used for metadata, sitemap and the links in WhatsApp messages)
SITE_URL=http://localhost:3000

# SQLite database file. Created automatically on first start.
DATABASE_PATH=./data/heritage-bites.db

# Staff console PIN. The default below is for local demos only: change it before going live.
STAFF_PIN=1234

# Secret used to sign the staff session cookie. Use a long random string in production.
STAFF_SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when the site is served over HTTPS so the staff cookie is marked Secure.
COOKIE_SECURE=false
